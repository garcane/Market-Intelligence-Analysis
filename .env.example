# Copy to .env and fill in real values. Never commit .env itself.
# Every variable is optional: the pipeline runs end to end with none set.
# Check what your plans allow with: python -m src.ingestion.probe_providers

# Ticker news comes from Yahoo Finance (yfinance) and needs no key.

# Finnhub company news for the historical backfill (equities only; the free
# plan reaches back about one year).
FINNHUB_API_KEY=

# Tiingo end-of-day prices: equity fallback when Yahoo Finance fails.
# Free plan is personal use only; don't publish data fetched with it.
TIINGO_API_TOKEN=

# Alpha Vantage NEWS_SENTIMENT for the backfill, equities and crypto, two
# years or more back (free: about 25 requests/day).
ALPHA_VANTAGE_API_KEY=

# Path to a PEM CA bundle for yfinance's curl_cffi backend. Only needed behind
# TLS-intercepting software on non-Windows systems; on Windows, src/config.py
# builds one from the OS certificate store automatically. Leave commented out
# unless needed: an empty value would be exported as an empty CA path.
# CURL_CA_BUNDLE=/path/to/ca-bundle.pem
